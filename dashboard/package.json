{
  "name": "factory-dashboard",
  "version": "0.2.0",
  "description": "Electron dashboard for factory-sim",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview"
  },
  "build": {
    "appId": "com.scottdavis.factory-simulation",
    "productName": "Factory Orchestration Simulator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": ["nsis"]
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": ["dmg"]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": ["AppImage"],
      "category": "Utility"
    }
  },
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^35.0.0",
    "electron-vite": "^5.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
